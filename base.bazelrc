# Bazel-wide general configs
common --enable_platform_specific_config
common --downloader_config=build/bazel/utils/downloader.cfg

# Note that file:/// needs 3 / to work with %workspace% on Windows.
common --registry=file:///%workspace%/build/bazel/registry
common --registry=https://bcr.bazel.build

# See https://docs.aspect.build/guides/bazelrc/
# Docs: https://bazel.build/reference/command-line-reference#flag--incompatible_strict_action_env
common --incompatible_strict_action_env
common --nolegacy_external_runfiles
# Skip eager local .runfiles symlink tree creation (SymlinkTree) during the build
# phase. Remote tests on RBE construct their input root directly from the
# in-memory RunfilesTree, while local tests and `bazel run` materialize runfiles
# on demand via sandbox mounts or RunfilesTreeUpdater.
common --nobuild_runfile_links

# Hardened sandboxes
common --nosandbox_default_allow_network
common --sandbox_fake_hostname
common --sandbox_fake_username

# Qemu is resource intensive and causes timeouts if concurrency is too high.
# Consume this resource to limit local parallelism for tests booting qemu:
# tags = ["resources:qemu_instances:1"],
common:linux --local_resources=qemu_instances=3
common:macos --local_resources=qemu_instances=1
common:windows --local_resources=qemu_instances=1

# Enable windows symlink and runfiles
startup --windows_enable_symlinks
common:windows --enable_runfiles

# Custom workspace commands
common:linux --workspace_status_command="prebuilts/python/linux-x86/bin/python3 build/bazel/utils/bazel_workspace.py"
common:macos --workspace_status_command="prebuilts/python/darwin-x86/bin/python3 build/bazel/utils/bazel_workspace.py"
common:windows --workspace_status_command="build\\bazel\\utils\\bazel_workspace.cmd"

# Enable repository cache hardlinks for fast zero-copy repo extraction
common --experimental_repository_cache_hardlinks

# Credential helper for GCE access
common:linux --credential_helper="*.googleapis.com=%workspace%/build/bazel/utils/credential_helper.sh"
common:macos --credential_helper="*.googleapis.com=%workspace%/build/bazel/utils/credential_helper.sh"
common:windows --credential_helper="*.googleapis.com=%workspace%/build/bazel/utils/credential_helper.cmd"

# googlesource
common:linux --credential_helper="*.googlesource.com=%workspace%/build/bazel/utils/credential_helper.sh"
common:macos --credential_helper="*.googlesource.com=%workspace%/build/bazel/utils/credential_helper.sh"
common:windows --credential_helper="*.googlesource.com=%workspace%/build/bazel/utils/credential_helper.cmd"

# Airlock
common:linux --credential_helper="*.pkg.dev=%workspace%/build/bazel/utils/credential_helper.sh"
common:macos --credential_helper="*.pkg.dev=%workspace%/build/bazel/utils/credential_helper.sh"
common:windows --credential_helper="*.pkg.dev=%workspace%/build/bazel/utils/credential_helper.cmd"

# Publish to the private BES backend.
common:sponge --grpc_keepalive_time=30s
common:sponge --bes_keywords=android-emulator
common:sponge --bes_backend=buildeventservice-pa.googleapis.com
common:sponge --bes_results_url=https://fusion2.corp.google.com/invocations/
common:sponge --bes_timeout=240s
common:sponge --build_event_upload_max_retries=5
common:sponge --legacy_important_outputs

common:no_sponge --bes_backend=
common:no_sponge --bes_results_url=

# Enable go/antswatcher to process test results.
# This config must be used with the sponge config as it relies on the same bes_backend.
# NOTE: Bazel invocations must still supply --build_metadata values for test_definition_name
common:ants --bes_keywords="android-test-storage"
common:ants --bes_keywords="antswatcher:skip_tests_if_timeout"
common:ants --build_metadata="generate_test_uri=fusion"
common:ants --build_metadata="run_type=critical"

# Base RBE configuration
common:_remote_base --grpc_keepalive_time=30s
common:_remote_base --remote_cache=grpcs://remotebuildexecution.googleapis.com
common:_remote_base --remote_instance_name=projects/emulator-builds/instances/default_instance
common:_remote_base --jobs=100
# remote_local_fallback allows bazel to continue if there are
# network connectivity failures (e.g., offline)
common:_remote_base --remote_local_fallback
# ThinLTO indexing on large targets (libgoldfish) outputs >20k files, exceeding RBE's 1MB ActionResult limit.
common:_remote_base --modify_execution_info=CppLTOIndexing=+no-remote


# Config to use hermetic SDKs (enabled by default; overridden in build:aosp)
common --config=hermetic
common:hermetic --@goldfish_build//toolchains/cc/mac_clang:hermetic_xcode
common:hermetic --@goldfish_build//toolchains/cc/windows_clang:hermetic_msvc
common:hermetic --repo_env=CC_ALLOW_HOST_SDK=0

# Java config
common --java_language_version=17
common --java_runtime_version=jdk17

# Configs for local builds with remote cache in read-only.
# This avoids re-running cached actions.
common:rcache --config=_remote_base
common:rcache --noremote_upload_local_results

# Configs for local builds with all online features
common:connected --config=rcache
common:connected --config=hermetic
common:connected --config=sponge

# Configs for remote builds with RBE
common:remote --config=_remote_base
common:remote --remote_executor=grpcs://remotebuildexecution.googleapis.com
common:remote --remote_timeout=3600
common:remote --show_timestamps
common:remote --jobs=200

# Configs to run certain actions dynamically
# Used when big action running on RBE is the main bottleneck while local
# resources are available.
common:dynamic --config=remote
common:dynamic --internal_spawn_scheduler
common:dynamic --strategy=CppLink=dynamic
common:dynamic --strategy=SymbolZip=dynamic
common:dynamic --strategy=PackageZip=local
common:dynamic --strategy=PythonZipper=dynamic
common:dynamic --strategy=Strip=dynamic
common:dynamic --strategy=GnuDebugInfo=dynamic
common:dynamic --strategy=ExtractBreakpadSymbols=dynamic

# Configs for CI builds
# When running CI, fail the build if the lockfile needs update
common:ci --lockfile_mode=error
# Only upload BEP-important local files (test.log, test.xml, timing profiles)
# rather than uploading multi-GB top-level release/symbol .zip archives to CAS.
common:ci --remote_build_event_upload=minimal
common:ci --experimental_collect_system_network_usage
common:ci --config=_remote_base
common:ci --config=sponge
common:ci --config=hermetic
# When targets are all cached the BES upload may take a long time.
common:ci --bes_timeout=600s
common:ci --experimental_enable_execution_graph_log
common:ci --experimental_execution_graph_log_dep_type=all

# Reduce log spam
common:ci --ui_event_filters=-info
common:ci --ui_event_filters=-debug
common:ci --noshow_progress
common:ci --noshow_loading_progress


# RBE-based cross-platform and multi-platform build configurations
# Experimental and best-effort support only; NOT tested in CI builds.
## (Any) -> Windows x64
common:rbe-win-x64 --config=hermetic --config=remote --remote_local_fallback=false
common:rbe-win-x64 --platforms=@goldfish_build//platforms:windows_x64
common:rbe-win-x64 --extra_execution_platforms=@goldfish_build//platforms:windows_x64
common:rbe-win-x64 --remote_upload_local_results=false

## (Any) -> Windows aarch64 (cross-compiled on windows x64)
common:rbe-win-aarch64 --config=hermetic --config=remote --remote_local_fallback=false
common:rbe-win-aarch64 --platforms=@goldfish_build//platforms:windows_aarch64
common:rbe-win-aarch64 --extra_execution_platforms=@goldfish_build//platforms:windows_x64
common:rbe-win-aarch64 --remote_upload_local_results=false

## (Any) -> Linux x64
common:rbe-linux-x64 --config=remote --remote_local_fallback=false
common:rbe-linux-x64 --platforms=@goldfish_build//platforms:linux_x64
common:rbe-linux-x64 --extra_execution_platforms=@goldfish_build//platforms:linux_x64
common:rbe-linux-x64 --remote_upload_local_results=false

## (Any) -> Linux aarch64 (cross-compiled on linux x64)
common:rbe-linux-aarch64 --config=remote --remote_local_fallback=false
common:rbe-linux-aarch64 --platforms=@goldfish_build//platforms:linux_aarch64
common:rbe-linux-aarch64 --extra_execution_platforms=@goldfish_build//platforms:linux_x64
common:rbe-linux-aarch64 --remote_upload_local_results=false

# Local cross-compiling for Windows ARM64 (aarch64)
common:win_arm64 --platforms=@goldfish_build//platforms:windows_aarch64
common:win_aarch64 --platforms=@goldfish_build//platforms:windows_aarch64

# External open-source AOSP configuration (b/555489617).
# downloader_aosp.cfg blocks storage.googleapis.com (including gs://emu-next-bazel),
# so --config=aosp cannot download @xcode_tools_hermetic and must fall back to
# the local host SDK (while default internal builds use hermetic_xcode=true).
common:aosp --repo_env=MULTISOURCE_REPO_TYPE=aosp
common:aosp --downloader_config=build/bazel/utils/downloader_aosp.cfg
common:aosp --@goldfish_build//toolchains/cc/mac_clang:hermetic_xcode=false
common:aosp --@goldfish_build//toolchains/cc/windows_clang:hermetic_msvc=false
common:aosp --repo_env=CC_ALLOW_HOST_SDK=1
