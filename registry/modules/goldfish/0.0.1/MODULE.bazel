# On Windows we package some DLLs in the release zip..
custom_toolchains = use_extension("@goldfish_build//extensions:toolchain.bzl", "toolchain")
use_repo(custom_toolchains, "dism_adk", "toolchain_hub")

# For studio_stats.proto
new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")

new_local_repository(
    name = "studio_stats",
    build_file = "//:studio_stats.BUILD",
    path = "tools/analytics-library/protos/src/main/proto",
)

new_local_repository(
    name = "prebuilt_python_windows",
    build_file = "//:python_windows.BUILD",
    path = "prebuilts/python/windows-x86",
)

new_local_repository(
    name = "ver_testdata",
    build_file = "//emulator/libs/ver:ver_testdata.BUILD",
    path = "prebuilts/android-emulator-build/common",
)

local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "local_repository")

local_repository(
    name = "prebuilt_android_sdk",
    path = "prebuilts/android/android-sdk",
)

