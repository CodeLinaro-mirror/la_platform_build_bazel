# Bazel tool configs

# WARNING: DO NOT set os-dependent --fearure flags (e.g. build:linux --features=...)
# in this file or any bazelrc file. Toggle them directly in features.bzl for corresponding
# cc toolchains. See ag/40496765 for reason.
#
# Use build/bazel/platforms/BUILD.bazel for target-platform-specific flags, but be aware of:
# https://bazel.build/reference/be/platforms-and-toolchains#platform_flags_repeated

common --host_platform='@host_platform//:host'
# info has to be overriden due to https://github.com/bazelbuild/bazel/issues/25145
info --host_platform='@platforms//host'

# These flags are necessary for bazel v9.0.0 compatibility.
# TODO(b/481315750): Fix the issues and remove these.
common --incompatible_autoload_externally=+cc_library,+cc_binary,+cc_test,+proto_library,+objc_library,+cc_proto_library

## C++
common --repo_env='BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1'
common --host_features='-thin_lto'

## Rust
# See https://bazelbuild.github.io/rules_rust/rust_settings.html#experimental_use_allocator_libraries_with_mangled_symbols
# Used to handle new allocator symbol mangling
common  --@rules_rust//rust/settings:experimental_use_allocator_libraries_with_mangled_symbols

# Allow unstable features for target code
common --@rules_rust//rust/settings:extra_rustc_env=RUSTC_BOOTSTRAP=1

# Allow unstable features for build tools (e.g. allocator libraries, etc)
common --@rules_rust//rust/settings:extra_exec_rustc_env=RUSTC_BOOTSTRAP=1

## Protobuf
common --proto_compiler=@protobuf//:protoc
common --proto_toolchain_for_cc=@protobuf//:cc_toolchain
# Use prebuilt protoc to save some build time.
# This currently causes failures with GRPC on Windows.
common:linux --@protobuf//bazel/toolchains:prefer_prebuilt_protoc
common:macos --@protobuf//bazel/toolchains:prefer_prebuilt_protoc

## Python
common --@rules_python//python/config_settings:bootstrap_impl=script
# On Windows the launch_emulator zip does not correctly support symlinks needed
# by to make the launcher directory work correctly.
common:windows --@rules_python//python/config_settings:build_python_zip=false

# Default clang tidy config, use --config clang-tidy
common:clang-tidy --aspects @aemu//tools/clang_tidy:defs.bzl%clang_tidy_aspect
common:clang-tidy --output_groups=tidy_fixes
common:clang-tidy "--@aemu//tools/clang_tidy:clang_tidy_config=@goldfish//:clang_tidy_config"
common:clang-tidy "--@aemu//tools/clang_tidy:clang_tidy_regex=s/m_//g"
