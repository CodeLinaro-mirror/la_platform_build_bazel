import %workspace%/build/bazel/base.bazelrc
import %workspace%/build/bazel/tool.bazelrc

common --define grpc_no_xds=true
common --define GRPC_ALLOW_EXCEPTIONS=0

# gtest uses this to build against ABSL
common --define absl=1

# Fast mode libc++ hardening
common --copt=-D_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_FAST
common --host_copt=-D_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_FAST


common:debug --compilation_mode=dbg --strip=never
common:release --compilation_mode=opt
common:release-assert --config=release --copt=-UNDEBUG
common:debug_symbols --features='generate_debug_symbols'
common:lto --config=release --features='thin_lto'

common:asan --features='asan'
# ASAN hits ODR violations with shared linkage due to rules_proto.
common:asan --dynamic_mode=off
common:msan --features='msan'
common:tsan --features='tsan'

common:citsan --config=ci
common:citsan --config=debug
common:citsan --config=tsan

common:ciasan --config=ci
common:ciasan --config=debug
common:ciasan --config=asan

# Clang-tidy execution configuration
common:tidy --@aemu//tools/clang_tidy:clang_tidy_enabled=true

# Code coverage configuration (LLVM source-based coverage)
coverage --build_tests_only
coverage --test_tag_filters=-tidy-test
coverage --combined_report=lcov
coverage --experimental_use_llvm_covmap
coverage --experimental_generate_llvm_lcov
coverage --instrumentation_filter=//emulator[/:],@goldfish//emulator[/:],//common[/:],//host[/:]

# Gfxstream software GLES (ANGLE) and Vulkan (Lavapipe) test environment.
common --@gfxstream//common/testenv:graphics_test_environment=gles_angle_vulkan_lavapipe
common --@gfxstream//common/testenv:vulkan_lavapipe_drivers=@goldfish//emulator/libs/ver:test_vulkan_icds
common:linux --@gfxstream//common/testenv:gles_angle_drivers=@goldfish_prebuilts_common//ANGLE:lib_linux_x86_64
common:macos --@gfxstream//common/testenv:gles_angle_drivers=@goldfish_prebuilts_common//ANGLE:lib_darwin_aarch64
common:windows --@gfxstream//common/testenv:gles_angle_drivers=@goldfish_prebuilts_common//ANGLE:lib_windows_x86_64

# User overrides must come last
try-import %workspace%/user.bazelrc
